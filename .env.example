# Copy to .env (never commit .env). Only the optional eval module needs keys.
# Ports (defaults shown). If you change STANDARDS_MCP_PORT, export it in your shell
# too so .mcp.json resolves it when Claude Code starts.
MLFLOW_PORT=5050
STANDARDS_MCP_PORT=8765
GATEWAY_PORT=4000

# --- optional: evals/ (LiteLLM gateway + promptfoo) ---
# Your own Anthropic API key. Evals make paid model calls.
ANTHROPIC_API_KEY=
# Any random string; promptfoo uses it to call the local gateway.
LITELLM_MASTER_KEY=sk-local-change-me
