{
  "get_standard": {
    "ok": true,
    "standard": {
      "version": "1.0.0",
      "tag_contract": [
        {
          "key": "demo.model_type",
          "description": "Model type; must be one of `model_types` and equal the MLflow experiment name.",
          "allowed_from": "model_types"
        },
        {
          "key": "demo.model_version",
          "description": "Model version folder, e.g. v1.",
          "pattern": "^v[0-9]+$"
        },
        {
          "key": "demo.experiment_id",
          "description": "Experiment folder name.",
          "pattern": "^[a-z][a-z0-9_]{2,40}$"
        },
        {
          "key": "demo.standard_version",
          "description": "Version of this standard the run was produced under; MAJOR must match the current standard.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "same_major_as_standard": true
        },
        {
          "key": "demo.data_snapshot",
          "description": "Lakehouse snapshot id from lakehouse/_manifest.json.",
          "pattern": "^synth-[a-z0-9-]+$"
        },
        {
          "key": "demo.lib",
          "description": "Training library; must be a supported library.",
          "allowed_from": "libraries"
        }
      ],
      "tracking": {
        "experiment_name": "{model_type}",
        "run_name": "{model_version}.{experiment_id}",
        "required_metrics": [
          "roc_auc",
          "pr_auc",
          "log_loss",
          "brier"
        ]
      }
    }
  },
