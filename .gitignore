.claude/skills/
.agents/skills/
.claude/settings.local.json

# python / tools
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# evals output
evals/output/
evals/node_modules/
.promptfoo/

.DS_Store

# optional memory MCP server data
.memory/
