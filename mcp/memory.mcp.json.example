{
  "mcpServers": {
    "standards-mcp": {
      "type": "http",
      "url": "http://localhost:8765/mcp"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.8.31"],
      "env": {
        "MEMORY_FILE_PATH": ".memory/memory.jsonl"
      }
    }
  }
}
